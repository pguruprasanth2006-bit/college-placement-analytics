# Flask Application Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=super-secret-development-key-change-in-production

# Database Configuration (MySQL)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=college_placement_db
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/college_placement_db

# Admin User Credentials for dashboard authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Testing / SQLite Fallback Mode (optional for environments without MySQL)
USE_SQLITE=False
SQLITE_DB_NAME=placement_system.db

